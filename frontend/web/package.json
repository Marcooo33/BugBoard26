{
  "name": "bug-board26",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:dev": "ng serve --configuration=development",
    "start:prod": "ng serve --configuration=production",
    "build": "ng build --base-href /",
    "build:dev": "ng build --configuration=development --base-href /",
    "build:prod": "ng build --configuration=production --base-href /",
    "build:prod:verbose": "ng build --configuration=production --base-href / --verbose",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:showcase": "ng build --configuration=showcase"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/router": "^21.2.25",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.28",
    "@angular/cli": "^21.2.28",
    "@angular/compiler-cli": "^21.2.25",
    "jsdom": "^27.4.0",
    "typescript": "~5.9.2",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@angular/build": {
      "undici": "7.30.1"
    }
  }
}
